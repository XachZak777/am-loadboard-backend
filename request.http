# Loadboard-backend — API endpoint collection
# Replace {{BASE}} with your server URL (default: http://localhost:8080)
# After successful login, copy the returned token and set it as the value of the {{TOKEN}} variable below

@BASE = http://localhost:8080
@TOKEN = <PASTE_JWT_HERE>

### Carrier validation (pre-register)
POST {{BASE}}/api/validate/carrier
Content-Type: application/json
Accept: application/json

{
  "lookupValue": "123456",
  "lookupType": "MC"
}

### Example success response (200) — validation preview (cached)
###
### {
###   "validationId": "11111111-2222-3333-4444-555555555555",
###   "lookupType": "MC",
###   "lookupValue": "123456",
###   "dotNumber": "987654321",
###   "mcNumber": "123456",
